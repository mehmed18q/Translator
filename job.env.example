# Copy this file to a protected location (for example /opt/translator/job.env)
# and pass it with --env-file.  Do not commit real credentials.

# Guereh database
GUEREH_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
GUEREH_SQLSERVER_SERVER=sql-server.example.com
GUEREH_SQLSERVER_DATABASE=YourDatabase
GUEREH_SQLSERVER_USERNAME=translator_job
GUEREH_SQLSERVER_PASSWORD=change-me
GUEREH_SQLSERVER_TRUSTED_CONNECTION=false
GUEREH_SQLSERVER_NO_ENCRYPT=false
GUEREH_SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# The scheduled job runs Guereh plus RugsTrust automatically when the
# RUGSTRUST server/database settings are configured. Set DATABASE_TARGET to
# guereh or rugstrust to restrict it to one database.
DATABASE_TARGET=auto

# RugsTrust database. The fixed table is RugCertificationLocalize.
RUGSTRUST_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
RUGSTRUST_SQLSERVER_SERVER=
RUGSTRUST_SQLSERVER_DATABASE=
RUGSTRUST_SQLSERVER_USERNAME=
RUGSTRUST_SQLSERVER_PASSWORD=
RUGSTRUST_SQLSERVER_TRUSTED_CONNECTION=false
RUGSTRUST_SQLSERVER_NO_ENCRYPT=false
RUGSTRUST_SQLSERVER_TRUST_SERVER_CERTIFICATE=true
RUGSTRUST_SQLSERVER_SCHEMA=dbo

# Language IDs are listed in translator_app/languages.py.
SOURCE_LANGUAGE_ID=1
TARGET_LANGUAGE_IDS=2,3
# Defaults to TARGET_LANGUAGE_IDS when omitted.
CLEANUP_LANGUAGE_IDS=2,3

# Omit JOB_TABLE to process every eligible Localize/Localizes table.
JOB_SCHEMA=dbo
JOB_TABLE=

# The scheduled job executes by default. Set true to do a safe dry run.
JOB_DRY_RUN=false
TRANSLATOR_PROVIDER=auto
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

BATCH_SIZE=100
PROGRESS_EVERY=1
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=0.2
RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_BACKOFF_FACTOR=2
LOG_DIR=logs

# The lock covers both translation and cleanup. An empty timeout means wait
# until a previous scheduled run has finished.
JOB_LOCK_FILE=var/translation_cleanup_job.lock
JOB_LOCK_TIMEOUT_SECONDS=
